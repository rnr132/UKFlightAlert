# Copy this file to .env and fill in your own values. Never commit .env —
# it's already covered by .gitignore.
#
# Get a token by registering (free) at:
# https://www.travelpayouts.com/programs/100/tools/api
TRAVELPAYOUTS_TOKEN=

# Weekly digest email (scripts/notify.py). SMTP_USER/PASSWORD: a Gmail
# app password works well here — needs 2FA enabled on the account, then
# generate one at https://myaccount.google.com/apppasswords (NOT your
# normal Gmail password). NOTIFY_RECIPIENTS: comma-separated email
# addresses — real people's data, never commit this either, and this is
# exactly why it's an env var and not a config/sweep.yaml value.
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_RECIPIENTS=
