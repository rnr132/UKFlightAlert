# Copy this file to .env and fill in your own values. Never commit .env —
# it's already covered by .gitignore.
#
# Get a token by registering (free) at:
# https://www.travelpayouts.com/programs/100/tools/api
TRAVELPAYOUTS_TOKEN=

# Weekly digest email (scripts/notify.py). SMTP_PASSWORD: a Resend API
# key — create one at https://resend.com/api-keys after verifying a
# sending domain (see TODO.md). The SMTP username and From address
# aren't secret, so they live in config/sweep.yaml's notify block
# instead of here (switched from Gmail/Yahoo to Resend 2026-09-17, see
# PLAN.md's delivery section). NOTIFY_RECIPIENTS: comma-separated email
# addresses — real people's data, never commit this either, and this is
# exactly why it's an env var and not a config/sweep.yaml value.
SMTP_PASSWORD=
NOTIFY_RECIPIENTS=
